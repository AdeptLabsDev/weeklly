# Copie para .env. O Task carrega este arquivo automaticamente.
# Nenhuma variável é segredo por enquanto; quando houver, ela entra aqui como placeholder.

# development | production. Padrão: production (logs JSON, templates embutidos).
WEEKLLY_ENV=development

# Endereço de escuta host:porta. Padrão: 127.0.0.1:8080 (só localhost).
WEEKLLY_ADDR=127.0.0.1:8080

# Arquivo SQLite. O diretório é criado no boot. Padrão: data/weeklly.db
WEEKLLY_DB_PATH=data/weeklly.db

# Fuso usado para decidir "hoje" até o fuso do navegador entrar (Fase 1).
WEEKLLY_TIMEZONE=America/Sao_Paulo

# Origem pública do site (esquema e host). Em development é deduzida de WEEKLLY_ADDR.
# Obrigatória em produção quando o login com o Google está ligado; precisa ser https.
# WEEKLLY_BASE_URL=https://weeklly.app

# Login com o Google (D14). Crie um "OAuth client ID" do tipo Web no Google Cloud
# Console e cadastre a URL de retorno: {WEEKLLY_BASE_URL}/entrar/google/callback
# Sem as duas variáveis o botão "Entrar com Google" explica que o login está desligado.
# WEEKLLY_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# WEEKLLY_GOOGLE_CLIENT_SECRET=change-me-google-client-secret
